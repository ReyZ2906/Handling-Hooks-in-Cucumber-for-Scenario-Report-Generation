def style_advice_mapping(ws):
    # ---------------- Borders ----------------
    thin = Side(style="thin", color="000000")
    border = Border(left=thin, right=thin, top=thin, bottom=thin)

    for row in ws.iter_rows():
        for cell in row:
            cell.border = border
            cell.alignment = Alignment(wrap_text=True, vertical="top")

    # ---------------- Header styling ----------------
    header_fill = PatternFill(
        start_color="1F4E78",
        end_color="1F4E78",
        fill_type="solid",
    )
    header_font = Font(bold=True, color="FFFFFF")
    header_align = Alignment(horizontal="center", vertical="center", wrap_text=True)

    for cell in ws[1]:
        cell.fill = header_fill
        cell.font = header_font
        cell.alignment = header_align

    # ---------------- Find column indices ----------------
    headers = {
        str(cell.value).strip(): idx
        for idx, cell in enumerate(ws[1], start=1)
    }

    cr_idx = headers.get("ContractReference")
    cr_list_idx = headers.get("ContractReferenceList")

    if not cr_idx or not cr_list_idx:
        return  # required columns not present

    # ---------------- Fluorescent highlight ----------------
    neon_green = PatternFill(
        start_color="39FF14",  # fluorescent green
        end_color="39FF14",
        fill_type="solid",
    )

    for row in ws.iter_rows(min_row=2):
        cr_cell = row[cr_idx - 1]
        cr_list_cell = row[cr_list_idx - 1]

        if not cr_cell.value or not cr_list_cell.value:
            continue

        cr = str(cr_cell.value).strip()
        cr_list = {
            v.strip()
            for v in str(cr_list_cell.value).split("|")
            if v.strip()
        }

        if cr in cr_list:
            cr_cell.fill = neon_green
            cr_cell.font = Font(bold=True)

    # ---------------- Auto column width ----------------
    for col in ws.columns:
        max_len = max(
            len(str(cell.value)) if cell.value is not None else 0
            for cell in col
        )
        ws.column_dimensions[col[0].column_letter].width = min(max_len + 2, 80)

    ws.freeze_panes = "A2"





