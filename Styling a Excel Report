def write_excel(
    writer,
    allmatched: pd.DataFrame,
    hourly_success: pd.DataFrame,
    hourly_fail: pd.DataFrame,
    cons_success: pd.DataFrame,
    cons_failure: pd.DataFrame,
    advice_mapping: pd.DataFrame,
) -> None:
    """Write the original five worksheets plus the new Advice_Mapping sheet."""

    write_and_style(
        allmatched,
        writer,
        sheet_name="ALLMatched",
        status_header="Status",
    )

    write_and_style(
        hourly_success,
        writer,
        sheet_name="ALLMatched_Success",
        status_header="AUTOMATION STATUS",
    )

    write_and_style(
        hourly_fail,
        writer,
        sheet_name="ALLMatched_Fail",
        status_header="AUTOMATION STATUS",
    )

    write_and_style(
        cons_success,
        writer,
        sheet_name="Consolidated_Success",
        status_header="Status",
    )

    write_and_style(
        cons_failure,
        writer,
        sheet_name="Consolidated_Failure",
        status_header="Status",
    )

    # ----- NEW SHEET -----
    advice_mapping.to_excel(
        writer,
        index=False,
        sheet_name="Advice_Mapping",
    )

    ws = writer.sheets["Advice_Mapping"]
    style_advice_mapping(ws)



